# Copy this file to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smarthealth?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_URL=http://localhost:5173
PORT=5000
